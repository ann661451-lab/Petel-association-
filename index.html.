<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Petel Association</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f1f5f9;
      margin: 0;
      color: #1f2937;
    }
    header {
      background: #087f5b;
      color: white;
      text-align: center;
      padding: 25px 12px;
    }
    main {
      max-width: 450px;
      margin: 35px auto;
      padding: 20px;
    }
    .carte {
      background: white;
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 3px 12px #0001;
    }
    input, button {
      box-sizing: border-box;
      width: 100%;
      padding: 13px;
      margin-top: 12px;
      border-radius: 7px;
      font-size: 16px;
    }
    input {
      border: 1px solid #ccc;
    }
    button {
      border: 0;
      background: #087f5b;
      color: white;
      font-weight: bold;
    }
    #message {
      overflow-wrap: anywhere;
    }
  </style>
</head>
<body>
  <header>
    <h2>Petel Association</h2>
    <p>Solidarité &amp; Développement</p>
  </header>

  <main>
    <div class="carte">
      <h3>Connexion</h3>
      <form id="formConnexion">
        <label for="email">Adresse e-mail</label>
        <input id="email" type="email"
          placeholder="Ton adresse e-mail" required>

        <label for="password">Mot de passe</label>
        <input id="password" type="password"
          placeholder="Ton mot de passe" required>

        <button type="submit">Se connecter</button>
      </form>
      <p id="message" role="status"></p>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="app.js"></script>
  <script>
    const formulaire = document.getElementById("formConnexion");
    const message = document.getElementById("message");

    formulaire.addEventListener("submit", async function(e) {
      e.preventDefault();
      message.textContent = "Connexion en cours...";

      try {
        if (!window.supabaseClient) {
          message.textContent =
            "Supabase n'est pas encore configuré. Vérifie app.js.";
          return;
        }

        const { data, error } =
          await window.supabaseClient.auth.signInWithPassword({
            email: document.getElementById("email").value.trim(),
            password: document.getElementById("password").value
          });

        if (error) throw error;

        if (data.session) {
          message.textContent = "Connexion réussie !";
          window.location.href = "dashboard.html";
        } else {
          message.textContent = "Aucune session reçue.";
        }
      } catch (error) {
        message.textContent =
          "Erreur : " + (error.message || "Connexion impossible.");
      }
    });
  </script>
</body>
</html>
